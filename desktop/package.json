{
  "name": "syndicates-desktop",
  "productName": "Syndicates Desktop",
  "version": "0.1.0",
  "description": "Animated wallpapers, desktop widgets and a customizable Home panel for Windows.",
  "main": "main.js",
  "author": "Syndicates",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.syndicates.desktop",
    "productName": "Syndicates Desktop",
    "files": [
      "*.js",
      "build.json",
      "renderer/**",
      "assets/**",
      "!test/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Syndicates Desktop",
      "runAfterFinish": true,
      "artifactName": "Syndicates-Desktop-Setup.exe"
    },
    "portable": {
      "artifactName": "Syndicates-Desktop-Portable.exe"
    }
  }
}
