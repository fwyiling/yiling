{
  "manifest_version": 3,
  "name": "Shield Client",
  "version": "0.7.0",
  "description": "Ad blocking, YouTube extras, privacy/malware protection, and a manga/novel downloader.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "downloads",
    "cookies",
    "privacy",
    "notifications",
    "alarms",
    "tabs",
    "topSites",
    "favicon",
    "webNavigation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Shield Client",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "easylist",
        "enabled": false,
        "path": "rules/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": false,
        "path": "rules/easyprivacy.json"
      }
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/yt-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/theme.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/youtube.js",
        "content/yt-features.js"
      ],
      "css": [
        "content/youtube.css",
        "skins/youtube.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/dock.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.com/webhp*",
        "*://www.google.co.uk/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*",
        "*://www.google.com.hk/search*",
        "*://www.google.com.sg/search*",
        "*://www.google.com.tw/search*"
      ],
      "css": [
        "skins/google.css"
      ],
      "run_at": "document_start",
      "js": [
        "content/recolor.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}